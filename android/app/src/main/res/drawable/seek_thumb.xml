<?xml version="1.0" encoding="utf-8"?>
<!-- The dot grows and gets a white ring when the remote is on the timeline -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><size android:width="22dp" android:height="22dp" /><solid android:color="@color/red" /><stroke android:width="3dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><size android:width="22dp" android:height="22dp" /><solid android:color="@color/red" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><size android:width="14dp" android:height="14dp" /><solid android:color="@color/red" /></shape>
    </item>
</selector>
